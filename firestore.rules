// =========================================================
// 하루햇빛 — Firestore 보안 규칙 (작업지시서 7절)
// Firebase 콘솔 › Firestore Database › 규칙 탭에 이 내용을 붙여 넣고 [게시]한다.
// 관리자 계정은 콘솔에서 먼저 만든다(아래 isAdmin). 만들기 전에는 관리자 조회만 막히고
// 앱의 업로드는 정상 동작한다.
// =========================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // 관리자 = Firebase 콘솔(Authentication › 사용자 추가)에서 만든 관리자 계정
    // 앱·관리자 페이지에서 아이디 'admin' 으로 로그인하면 admin@haru-sunlight.firebaseapp.com 로 바뀐다.
    // 관리자를 늘리려면 콘솔에서 계정을 더 만들고 이 목록에 넣는다.
    // ⚠️ 이메일만 보므로, 이 관리자 계정이 콘솔에 없거나 지워진 상태면 누구나 앱에서 'admin'으로
    //    가입해 관리자 권한을 얻는다. 계정을 꼭 먼저 만들어 두고, 만든 뒤에는 아래처럼 uid까지 묶는 걸 권한다.
    //    (콘솔 › Authentication › 사용자 목록의 '사용자 UID')
    //      && request.auth.uid in ['여기에-관리자-UID']
    function isAdmin() {
      return signedIn()
        && request.auth.token.get('email', '') in ['admin@haru-sunlight.firebaseapp.com'];
    }

    match /users/{uid} {
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['createdAt','updatedAt','consentedAt','consentVersion','skinType','sido','notify','appVersion',
              'ageGroup','bmiGroup'])
        // 나이 · 키 · 몸무게 원값은 받지 않는다 — 연령대와 BMI 구간만
        && (!('ageGroup' in request.resource.data) || request.resource.data.ageGroup in [10, 20, 30, 40, 50, 60, 70])
        && (!('bmiGroup' in request.resource.data)
            || request.resource.data.bmiGroup in ['under', 'normal', 'pre', 'obese1', 'obese2'])
        // 글자 항목은 형식 · 길이를 막는다 — 통계 오염과 CSV 수식 주입 방지
        && (!('skinType' in request.resource.data)
            || (request.resource.data.skinType is int
                && request.resource.data.skinType >= 1 && request.resource.data.skinType <= 6))
        && (!('sido' in request.resource.data)
            || (request.resource.data.sido is string && request.resource.data.sido.size() <= 10))
        && (!('notify' in request.resource.data) || request.resource.data.notify is bool)
        && (!('consentVersion' in request.resource.data)
            || request.resource.data.consentVersion.matches('^v[0-9]{1,3}$'))
        && (!('appVersion' in request.resource.data)
            || request.resource.data.appVersion.matches('^v_[0-9]{1,3}[.][0-9]{1,3}$'));
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // 관리자 — 로그인이 안 되는 참가자를 직접 만든다(manual-…), 합치기 · 삭제 때 지운다
      allow create: if isAdmin()
        && uid.matches('^manual-[a-z0-9]{4,20}$')
        && request.resource.data.keys().hasOnly(['createdAt','manual','editedBy'])
        && request.resource.data.manual == true
        && request.resource.data.editedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 타이머 기록 한 건의 값 검사 — 참가자 업로드와 관리자 수정이 같이 쓴다
    function validSession(d, docId) {
      return d.minutes is int
        && d.minutes >= 1 && d.minutes <= 600
        && d.percent is int
        && d.percent >= 0 && d.percent <= 300
        && d.clothing in ['shortShort','shortLong','longLong']
        && d.limitedBy in ['vitd','burn','heat']
        // 문서 ID는 {uid}_{at} 형식만 — 같은 기록을 ID만 바꿔 여러 번 올리지 못하게
        && d.at is int
        && docId == d.uid + '_' + string(d.at)
        && d.dateKey is string
        && d.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('endedBy' in d) || (d.endedBy is string && d.endedBy.matches('^[a-z]{1,12}$')));
    }

    match /sessions/{docId} {
      // 참가자 — 자기 기록을 한 번 올리면 끝. 고치거나 지우지 못한다
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['uid','dateKey','at','minutes','percent','clothing','limitedBy','endedBy','uploadedAt'])
        && validSession(request.resource.data, docId);
      // 관리자 — 기록을 넣고 · 고치고 · 지운다. 바꾼 내용은 adminLog에 따로 남긴다(관리자 화면이 같이 쓴다)
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['uid','dateKey','at','minutes','percent','clothing','limitedBy','endedBy','uploadedAt',
              'manual','editedAt','editedBy'])
        && request.resource.data.uid is string && request.resource.data.uid.size() <= 128
        && request.resource.data.editedBy == request.auth.uid
        && (!('manual' in request.resource.data) || request.resource.data.manual is bool)
        && validSession(request.resource.data, docId)
        && (resource == null || (resource.data.uid == request.resource.data.uid && resource.data.at == request.resource.data.at));
      allow delete: if isAdmin();
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // 관리자 변경 내역 — 쓰기만 하고 고치거나 지우지 못한다
    match /adminLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['at','by','action','target','before','after','reason'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.action in ['add','edit','delete','merge','addUser','deleteUser']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1 && request.resource.data.reason.size() <= 200
        && request.resource.data.target is string && request.resource.data.target.size() <= 160;
      allow update, delete: if false;
    }

    // 그 외는 전부 막음
    match /{document=**} { allow read, write: if false; }
  }
}
